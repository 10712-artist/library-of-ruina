import random

class Dice:
    def __init__(self, dice_type, min_val, max_val, power_bonus=0):
        self.dice_type = dice_type  # 'Slash', 'Pierce', 'Blunt', 'Block', 'Evade'
        self.min_val = min_val
        self.max_val = max_val
        self.power_bonus = power_bonus

    def roll(self):
        # 기본 굴림값 + 환상체 책장 등의 위력 보정치
        base = random.randint(self.min_val, self.max_val)
        return max(1, base + self.power_bonus), base

class Card:
    def __init__(self, name, cost, dice_list):
        self.name = name
        self.cost = cost
        self.dice_list = dice_list

class AbnormalityPage:
    def __init__(self, name, description, power_boost=1):
        self.name = name
        self.description = description
        self.power_boost = power_boost

class Character:
    def __init__(self, name, max_hp, base_speed_dice=1):
        self.name = name
        self.max_hp = max_hp
        self.hp = max_hp
        
        # 속도 주사위 및 빛 자원
        self.base_speed_dice_count = base_speed_dice
        self.max_light = 3
        self.current_light = 3
        
        # 감정 시스템
        self.emotion_level = 0
        self.emotion_coins = 0
        self.max_emotion_level = 5
        
        # 환상체 책장 효과
        self.active_abno_pages = []
        self.global_power_bonus = 0
        
        self.deck = []

    @property
    def speed_dice_count(self):
        # 감정 단계 2, 4 도달 시 속도 주사위 슬롯 추가
        bonus_dice = 0
        if self.emotion_level >= 2: bonus_dice += 1
        if self.emotion_level >= 4: bonus_dice += 1
        return self.base_speed_dice_count + bonus_dice

    @property
    def coins_for_next_level(self):
        return 3 + (self.emotion_level * 2)

    def gain_emotion_coin(self, amount=1):
        if self.emotion_level >= self.max_emotion_level:
            return False
            
        self.emotion_coins += amount
        print(f"   └─ [{self.name}] 감정 코인 +{amount} ({self.emotion_coins}/{self.coins_for_next_level})")
        
        if self.emotion_coins >= self.coins_for_next_level:
            return self.level_up_emotion()
        return False

    def level_up_emotion(self):
        self.emotion_coins -= self.coins_for_next_level
        self.emotion_level += 1
        self.max_light += 1
        self.current_light = self.max_light  # 빛 전액 회복
        
        print(f"\n★==================================================★")
        print(f"★ [{self.name}] 감정 단계 상승! ➔ Lv.{self.emotion_level}")
        print(f"★ [최대 빛]: {self.max_light} (완전 회복) | [속도 주사위 수]: {self.speed_dice_count}개")
        print(f"★==================================================★\n")
        return True # 환상체 책장 선택 이벤트 트리거

    def apply_abnormality_page(self, page):
        self.active_abno_pages.append(page)
        self.global_power_bonus += page.power_boost
        print(f"👁️ [{self.name}] 환상체 책장 적용: <{page.name}> -> {page.description}")

    def roll_speed_dice(self):
        dice_results = [random.randint(1, 6) for _ in range(self.speed_dice_count)]
        return sorted(dice_results, reverse=True)

    def start_new_scene(self):
        self.current_light = min(self.max_light, self.current_light + 1)

# ==========================================
# 환상체 책장 선택 이벤트
# ==========================================

ABNO_POOL = [
    AbnormalityPage("식의 형상", "모든 주사위 위력 +1", power_boost=1),
    AbnormalityPage("붉은 흉터", "모든 주사위 위력 +2", power_boost=2),
    AbnormalityPage("포옹", "모든 주사위 위력 +1", power_boost=1)
]

def trigger_abnormality_selection(character):
    print(f"\n🔮 [환상체 책장 선택 단계 발동!]")
    selected_page = random.choice(ABNO_POOL)
    character.apply_abnormality_page(selected_page)

# ==========================================
# 다중 속도 주사위 합(Clash) 진행
# ==========================================

def resolve_scene_combats(p1, p2):
    p1_speed = p1.roll_speed_dice()
    p2_speed = p2.roll_speed_dice()
    
    print(f"\n🎲 속도 주사위 굴림 결과")
    print(f"  [{p1.name} (슬롯 {len(p1_speed)}개)]: {p1_speed}")
    print(f"  [{p2.name} (슬롯 {len(p2_speed)}개)]: {p2_speed}")

    # 슬롯별 카드 배정 및 합 진행
    max_slots = max(len(p1_speed), len(p2_speed))
    
    for slot in range(max_slots):
        print(f"\n--------------------------------------------------")
        print(f"⚔️ [속도 주사위 슬롯 #{slot + 1} 전투 진행]")
        
        # 카드 선택 (빛 소모 가능 여부 체크)
        card1 = p1.deck[0] if p1.current_light >= p1.deck[0].cost else None
        card2 = p2.deck[0] if p2.current_light >= p2.deck[0].cost else None
        
        if card1 and card2:
            p1.current_light -= card1.cost
            p2.current_light -= card2.cost
            
            print(f"[{p1.name}] '{card1.name}' VS [{p2.name}] '{card2.name}'")
            
            # 카드의 각 주사위에 캐릭터 글로벌 위력 보정 합산
            for idx in range(max(len(card1.dice_list), len(card2.dice_list))):
                d1 = card1.dice_list[idx] if idx < len(card1.dice_list) else None
                d2 = card2.dice_list[idx] if idx < len(card2.dice_list) else None
                
                if d1 and d2:
                    d1.power_bonus = p1.global_power_bonus
                    d2.power_bonus = p2.global_power_bonus
                    
                    r1, base1 = d1.roll()
                    r2, base2 = d2.roll()
                    
                    print(f"  - [{d1.dice_type}] {r1} (기본 {base1}+보너스 {d1.power_bonus}) vs [{d2.dice_type}] {r2} (기본 {base2}+보너스 {d2.power_bonus})")
                    
                    if r1 > r2:
                        p2.hp = max(0, p2.hp - r1)
                        print(f"    🏆 [{p1.name}] 합 승리! -> {p2.name}에게 {r1} 피격 (남은 HP: {p2.hp})")
                        lvl_up = p1.gain_emotion_coin(1)
                        if lvl_up: trigger_abnormality_selection(p1)
                    elif r2 > r1:
                        p1.hp = max(0, p1.hp - r2)
                        print(f"    🏆 [{p2.name}] 합 승리! -> {p1.name}에게 {r2} 피격 (남은 HP: {p1.hp})")
                        lvl_up = p2.gain_emotion_coin(1)
                        if lvl_up: trigger_abnormality_selection(p2)
                    else:
                        print("    ⚖️ 무승부!")
                        
        elif card1 and not card2:
            print(f"[{p1.name}]의 일방 공격!")
            r1, _ = card1.dice_list[0].roll()
            p2.hp = max(0, p2.hp - r1)
            print(f"  -> {p2.name}에게 {r1} 피격! (남은 HP: {p2.hp})")
            
        if p1.hp <= 0 or p2.hp <= 0:
            break

# ==========================================
# 실행 테스트
# ==========================================

player = Character("롤랑", max_hp=100)
enemy = Character("핏빛밤", max_hp=100)

sample_card = Card("연속 베기", cost=1, dice_list=[Dice("Slash", 3, 8), Dice("Pierce", 2, 6)])
player.deck = [sample_card]
enemy.deck = [sample_card]

# 막(Scene) 진행
for scene in range(1, 4):
    print(f"\n==================================================")
    print(f"                   [ Scene {scene} ]")
    print(f"==================================================")
    player.start_new_scene()
    enemy.start_new_scene()
    
    resolve_scene_combats(player, enemy)
    
    if player.hp <= 0 or enemy.hp <= 0:
        break